# Entity definitions for test_level
# Format: type name group posX posY posZ rotY [key=value ...]

# Player spawn point
player spawn - 0 1 0 0

# Animated decoration: mrfixit standing in Room 1
decoration mrfixit_01 props -2 0 -1 0 iqm=models/mrfixit.iqm scale=0.225 flip_cull=1

# Workstation in Room 1 (desk with CRT, keyboard, tower PC, and chair)
# Desk origin is bottom-center; monitor+keyboard sit on desk top (assumed ~0.75m high)
decoration office_desk_01   props -2.7  0    -3   0   mesh=models/office-desk.obj        tex=models/wood1.bmp  collide=box
decoration crt_monitor_01   props -2.9  0.8  -3.2 0   mesh=models/crt-monitor.obj        tex=models/office.bmp collide=box
decoration keyboard_01      props -2.5  0.8  -3.2 0   mesh=models/keyboard.obj           tex=models/office.bmp collide=box
decoration pc_tower_01      props -2.9  0.8  -2.7 0   mesh=models/midi-tower-pc-case.obj tex=models/office.bmp collide=box
decoration office_chair_01  props -2    0    -3.2 200 mesh=models/office-chair.obj       tex=models/office.bmp collide=box
# Sliding door — rises 1.2m when triggered, auto-closes after 3s
#door slide_door_01  props 2 0 -3 0  mesh=models/door.obj tex=models/wood1.bmp  motion=slide  axis=Y amount=1.2 speed=2.0 auto_close=3.0
#trigger slide_trigger - 2 1 -1 0  size=1.5,2,1.5 target=slide_door_01 once=0

# Rotating door — swings 90° open, auto-closes after 3s.
# Note: door.obj origin is not on the hinge edge, so the rotation looks like
# it spins around its own center. Functional though — good for verifying rotate+sweep.
door rotate_door_01  props 2 0 -3 0  mesh=models/door.obj tex=models/wood1.bmp  motion=rotate axis=Y amount=90  speed=120 auto_close=3.0
trigger rotate_trigger - 2 1 -1 0  size=1.5,2,1.5 target=rotate_door_01 once=0

# Test trigger near the ramp
trigger ramp_zone - 11 1 0 0 size=3,3,3 target=mrfixit_02 once=0
